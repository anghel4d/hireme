  metric market_cap_usd f64
  metric revenue_usd f64
  metric revenue_growth f64
  metric profit_margin f64
  metric pe_ratio f64
  group comp and reputation
  metric comp_median_usd f64
  metric comp_swe_median_usd f64
  metric rating f64
  metric rating_count u32
  metric wlb_rating f64
  group hiring
  col careers_url str ?
  col ats str ?
  col ats_tenant str ?
  col remote_policy enum remote_policy ?
  group desk
  col score_100 u8 ?
  col freshness enum freshness ?
  col freshness_on day ?
