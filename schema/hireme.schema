table offices world resident
  cap 200000
  unique corporation_id place_id kind
  index place_id
  col corporation_id ref corporations !
  col place_id ref places !
  col kind enum office_kind !
  metric headcount u32
  col opened_on day ?

table sources world resident soft_delete
  cap 200000
  natural url
  index host
  col url str !
  # Derived from url by the server.
  col host str ! readonly
  col publisher str ?
  col title str ?
  col kind enum source_kind ?
  col retrieved_at time ?
  # A mutable page keeps only its newest doc; an immutable one keeps each.
  col mutable bool ! = true
  col doc text ?

# The only provenance authority: the newest citation for a cell is its source.
# Replicated read-only under the world bit: the server writes every row.
table citations world resident append_only
  cap 5000000
  index table row_id column id desc
  # A source's drop asks whether any citation names it, under the writer lock.
  index source_id
  col table str ! readonly
  col row_id u32 ! readonly
  col column str ! readonly
  col source_id ref sources ? readonly loose
  col value json ? readonly
  col as_of day ! readonly
  col actor enum actor ! readonly
  col key_id ref api_keys ? readonly loose
  col op_id i64 ? readonly

# ---------------------------------------------------------------- mail

table contacts mail resident
  natural email where email is not null
  cap 50000
  index corporation_id
  col corporation_id ref corporations ?
  col place_id ref places ?
  col name str !
  col title str ?
  col email str ?
  col linkedin_url str ?
  col x_handle str ?
  col relation enum relation ?
  col last_touch_on day ?
  col notes text ?

# The OutreachItem (docs/mail/outreach_type.md): one row per thing said or
# done on any channel, a mail, a LinkedIn message, an X DM, a Discord
# message, a careers-page submission, a note. `kind` is the variant; the
# core comes first, then each variant's own columns, sparse. Items are the
# record of what happened: a draft is its mission's. The kernel's
# `outreach` module is the one reading of a row, and the one judge of a
# put: what each kind requires, what is fixed once written, what is
# derived (at, actor, the implied refs, thread_key, filing) and the
# filer's filing of an inbound item. The messages table, renamed in place
# (0008_outreach): its number and surviving column ids stay.
table outreach mail resident
  natural message_id where message_id is not null
  cap 200000
  index thread_key
  index application_id
  index contact_id
  index mission_id
  index at desc
  col kind enum outreach_kind !
  # Null for a note; a careers-page item is outbound.
  col direction enum direction ?
  # A mail's sender and recipients (to and cc U+001F-joined, 1 to 10 and 0 to 10).
  col from_addr str ?
  col to_addr str ?
  col cc_addr str ?
  # A mail's subject; a one-line title for anything else.
  col subject str ?
  # The text that was said: plain text, markdown for a note.
  col body text ?
  # A mail's Message-ID as given; the natural key (a second pipe's copy updates the row).
  col message_id str ?
  # The filer's, else the root of refs, else in_reply_to, else message_id.
  col thread_key str ? readonly
  # The item's instant: sent, received, submitted, written. Now when a put leaves it out.
  col at time ?
  # status, derived now (sent, received, bounced), never stored.
  retired col 1
  col corporation_id ref corporations ?
  col application_id ref applications ?
  col contact_id ref contacts ?
  col mission_id ref missions ?
  # The conversation or page: an http(s) URL.
  col link str ?
  # An agent's write-up of a self-reported act, markdown: required of an
  # agent's outbound item on an untracked channel.
  col report text ?
  # Who wrote the item: the operator, a key, the mail actor (the node, no key).
  col actor enum actor ! = system readonly
  # Filed when any ref is set, unfiled when none, ignored by the command.
  col filing enum filing ! = unfiled readonly
  col filed_by enum filer ? readonly
  # The filer's tokens and candidates.
  col evidence json ? readonly
  # The reply marker on an inbound item.
  col seen bool ! = false
  # email
  col bounced_at time ? readonly
  col reply_to str ?
  col in_reply_to str ?
  # The References header as written, space-separated.
  col refs text ?
  col gmail_msgid i64 ?
  col gmail_thrid i64 ?
  # X-GM-LABELS, U+001F-joined.
  col labels str ?
  # The few headers the filer reads (lowercased names) and a bounce's report.
  col headers json ?
  col pipe enum mail_pipe ?
  # linkedin, x_dm, discord, other: the counterpart's name on that channel.
  col handle str ?
  # careers_page: the fields as submitted, and the reference the page showed.
  col fields json ?
  col reference str ?
  # other: the channel's name (slack, phone, meetup).
  col channel str ?
  command file application_id? mission_id? contact_id? corporation_id?
  command ignore

# The lanes (gym_reps, net_entries), cut with their lens.
retired table 2

# ---------------------------------------------------------------- wire

# One row per wire session holding the channel; `held` is its claimed
# application ids, U+001F-joined.
table leases desk wire
  col id u32 !
  col label str !
  col key_id u32 ?
  col held str ?
  col since time !

table clock system wire
  col today day !
  col now time !

# The resolved declaration, one row per entry: kind 1 table, 2 column,
# 3 enum value, 4 command, 5 command param, 6 frame.
table catalog system wire
  col kind u32 !
  col owner u32 !
  col id u32 !
  col name str !
  col type u32 ?
  col flags u32 ?
  col target str ?

# The trusted hosts, replicated read-only so a replica predicts source_trust.
projection trusted world trusted_hosts where host is not null
  pick host note

# The account page's views: read by the operator's browser session only,
# never a key, and never a secret (no hash, token, TOTP secret, credential
# or recovery code). The sequencer re-reads them when the account's trail
# moves and patches what changed; acct_audit holds the newest events.
projection acct_keys system api_keys where key_id is not null
  pick key_id name prefix read_mask write_mask may_delete last_used_at expires_at revoked_at paused_at inserted_at
projection acct_sessions system sessions where revoked_at is null
  pick authenticated_at mfa_at last_seen_at expires_at ip user_agent
projection acct_identities system identities where subject is not null
  pick provider display verified_at
projection acct_factors system factors where disabled_at is null
  pick kind name transports backup_eligible backed_up verified_at last_used_at
projection acct_audit system audit where kind is not null
  pick kind ip user_agent meta key_id session_id security inserted_at

table acct_info system wire
  col name str ?
  col status enum account_status !
  col recovery_codes_left u32 !

# ---------------------------------------------------------------- me and CVs

# The person, one row: everything person-specific (settings keeps the app's own knobs).
table me corpus resident singleton
  cap 1
  # U+001F-joined ISO 3166-1 alpha-2.
  col citizenships str ?
  col field str ?
  # U+001F-joined words under field.
  col subfields str ?
  # Where the person lives; a pattern reads me.residence, the place's ISO2.
  col residence_id ref places ?
  # U+001F-joined ISO 3166-1 alpha-2 or ISO 3166-2 codes.
  col regions str ?
  col relocate bool ?
  # The root an application gets when no rule matches.
  col cv_default_root_id ref cv_roots ?
  # Sets: bit 1 << code per work_mode, per employment.
  col work_modes u32 ?
  col employments u32 ?
  # A year's pay, in pay_currency (ISO 4217).
  col pay_floor u32 ?
  col pay_currency str ?
  col available_on day ?
  col notice_days u32 ?
  # The seven fixed atlas weights: replaced by `weights` (0003_atlas).
  retired col 7
  # U+001F-joined ISO 3166-1 alpha-2: countries where a work permit or a
  # residence right is already held; countries wanted (the atlas orders
  # them first) and never wanted (last, never hidden).
  col work_permits str ?
  col prefer str ?
  col avoid str ?
  # What an agent drafting for the person should know.
  col notes text ?
  # The atlas's order: {"<places metric>": weight, "route": weight,
  # "language": weight}. A negative weight ranks a lower figure higher.
  col weights json ?

# The languages the person speaks, a row each (ISO 639-1).
table languages corpus resident
  natural code
  cap 200
  col code str !
  col level enum language_level !

# A CV the operator keeps: a file lineage (markdown, pdf, docx) or a profile's
# items composed.
table cv_roots corpus resident soft_delete
  cap 1000
  unique slug
  col slug str !
  col name str !
  col format enum cv_format !
  col profile_id ref profiles ?
  col notes text ?
  # Its newest version, set by the server as one lands; null while it has none.
  col version_id ref cv_versions ? readonly

# Each edit or upload of a root, never changed: markdown in body, a file by its
# blob's SHA-256 (hex); text is what the server read from it.
table cv_versions corpus resident append_only
  cap 100000
  index root_id id desc
  col root_id ref cv_roots !
  col n u32 ! readonly
  col body text ?
  col blob_sha str ?
  col blob_name str ?
  col blob_type str ? readonly
  col blob_bytes u32 ? readonly
  col text text ? readonly
  col note str ?
  col actor enum actor ! readonly
  col key_id ref api_keys ? readonly loose

# A file's bytes by SHA-256, served over HTTP (/blobs/<sha>), never on the wire.
table blobs corpus server
  cap 1000
  unique sha
  col sha str !
  col type str !
  col bytes u32 !
  col data bytes ! server_only
  # What extraction read from it, once, at upload.
  col text text ? server_only

# Named patterns a rule (or another mask) names.
table cv_masks corpus resident
  cap 1000
  unique name
  col name str !
  col pattern text !
  col note str ?

# One ordered match by (position, id): the first enabled rule whose pattern
# holds picks its root.
table cv_rules corpus resident
  cap 1000
  index position
  col position u32 ! = 0
  col root_id ref cv_roots !
  col name str ?
  col pattern text !
  col enabled bool ! = true

# ---------------------------------------------------------------- missions and fire

# One route of an application (a careers page, the hiring address, a
# LinkedIn message, ...): the unit of fire. Its draft is markdown (a form's
# fields, a message's text); an email mission's is the mail itself: target
# its To (up to 10 addresses), cc, subject, draft its body, in_reply_to and
# refs for a follow-up. in_flight and fired are the commands' alone, and a
# mission in flight or fired takes no edit.
table missions desk resident
  cap 200000
  index application_id
  col application_id ref applications !
  # Any outreach kind but note.
  col kind enum outreach_kind !
  # An address, a URL or a handle.
  col target str ?
  col contact_id ref contacts ?
  col draft text ?
  col state enum mission_state ! = draft
  col last_error text ? readonly
  col fired_at time ? readonly
  col fired_by enum actor ? readonly
  col fire_key_id ref fire_keys ? readonly loose
  col fired_with ref api_keys ? readonly loose
  col in_flight_at time ? readonly
  col confirmation enum confirmation ? readonly
  col note text ?
  col cc str ?
  col subject str ?
  col in_reply_to str ?
  col refs text ?
  # The Message-ID the node minted for the shot, stamped before it sends;
  # the Gmail ids once it landed.
  col message_id str ? readonly
  col gmail_msgid i64 ? readonly
  col gmail_thrid i64 ? readonly
  # The CV version the shot carries, as the application's pick named it
  # when it was fired: the one the key's hash covered.
  col cv_version_id ref cv_versions ? readonly
  # Starts a shot, under a live key covering the mission.
  command fire key:u32?
  command stamp message_id
  # The shot's outcome: an email's from the mail actor, another's from the
  # key that fired it or the operator.
  command landed gmail_msgid:i64? gmail_thrid:i64?
  command failed reason:text

# An agent's ask for a key, which the operator turns into one (or declines)
# at /fire/<id>.
table fire_requests desk resident
  cap 10000
  # Ranges of mission ids, canonical ("1-44,56-213,444").
  col missions str !
  col reason str ?
  col requested_by ref api_keys ? readonly loose
  col status enum request_status ! = open readonly
  col fire_key_id ref fire_keys ? readonly loose
  command decline human_only

# The operator's authority to fire the missions it names, one shot each:
# a week unused, 24 hours from its first use. Only its commands write it.
table fire_keys desk resident
  cap 10000
  col scope str ! readonly
  # The API key that may use it; null for any of the account's.
  col usable_by ref api_keys ? readonly loose
  col request_id ref fire_requests ? readonly loose
  col first_used_at time ? readonly
  col expires_at time ! readonly
  col revoked_at time ? readonly
  command create_fire_key missions:str digest:str usable_by:u32? request:u32? human_only
  command revoke_fire_key human_only

# A key's frozen scope: each mission it covers and the SHA-256 of what that
# mission fires as the key was made, burned when its shot lands.
table fire_shots desk resident
  cap 1000000
  unique fire_key_id mission_id
  index mission_id
  col fire_key_id ref fire_keys ! readonly
  col mission_id ref missions ! readonly
  col hash str ! readonly
  col burned_at time ? readonly

# The linked mailbox. The node writes its server_only cells (the sealed
# secrets and the cursor) with its own server write, never a put.
table mailboxes mail resident singleton
  cap 1
  unique pipe_id global where pipe_id is not null
  col provider enum mail_provider ! = gmail
  col address str !
  col status enum mailbox_status ! = linking readonly
  col last_sync_at time ? readonly
  col last_error text ? readonly
  col daily_cap u32 ! = 25 human_only
  # The domain pipe's public id (12 base62): the node resolves an account by it.
  col pipe_id str ? server_only
  col secret bytes ? server_only
  col pipe_secret bytes ? server_only
  col folder str ? server_only
  col uidvalidity u32 ? server_only
  col last_uid u32 ? server_only
  # The first sync's progress, so linking a large mailbox reads as work, not
  # a hang: messages walked of those its window listed; cleared once live.
  col sync_done u32 ? readonly
  col sync_total u32 ? readonly
  command mailbox_state status last_error? last_sync_at?
  command unlink_mail human_only
