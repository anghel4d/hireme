Two changes to wtransport 0.7.2's server accept (src/endpoint.rs), applied by
the release build to the vendored crate; development builds run unpatched.

1. SETTINGS at 0.5-RTT. Chromium sends the CONNECT only once the server's
   HTTP/3 SETTINGS arrive, and wtransport sent them after the handshake
   completed, so a cold session cost a round trip more than it needs.
2. A connection whose accept future is dropped is closed, instead of being
   held open by keep-alives while its client waits.

--- a/src/endpoint.rs	2026-10-18 05:23:14.775905854 +0000
+++ b/src/endpoint.rs	2026-10-18 05:23:26.960786521 +0000
@@ -613,8 +613,35 @@
 
     fn new(quic_incoming: quinn::Incoming) -> Self {
         Self(Box::pin(async move {
-            let quic_connection = quic_incoming.await?;
-            Self::accept(quic_connection).await
+            // hireme: send SETTINGS at 0.5-RTT, once the ClientHello is whole.
+            // The client's CONNECT waits for SETTINGS, so leaving them until
+            // the handshake completes costs a round trip; before the whole
+            // ClientHello is in, the client's stream limits are unknown and
+            // the driver's control stream never gets the credit to open.
+            let mut handshake = quic_incoming.accept()?;
+            let _ = handshake.handshake_data().await;
+            let quic_connection = match handshake.into_0rtt() {
+                Ok((connection, _)) => connection,
+                Err(handshake) => handshake.await?,
+            };
+            // hireme: the driver keeps its own clone of the connection, so a
+            // caller that drops this future (a handshake deadline) would leave
+            // it open on keep-alives with the client waiting. Close it unless
+            // a session request comes out.
+            struct Abandoned(Option<quinn::Connection>);
+            impl Drop for Abandoned {
+                fn drop(&mut self) {
+                    if let Some(connection) = self.0.take() {
+                        connection.close(0u32.into(), b"abandoned");
+                    }
+                }
+            }
+            let mut abandoned = Abandoned(Some(quic_connection.clone()));
+            let request = Self::accept(quic_connection).await;
+            if request.is_ok() {
+                abandoned.0 = None;
+            }
+            request
         }))
     }
 
