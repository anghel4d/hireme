# Whitelist gitignore: everything is ignored unless named below.
# To track something new, name it here.
# https://rgbcu.be/blog/gitignore/
*
!.gitignore
!/README.md
!/SECURITY.md
!/LICENSE
!/.formatter.exs
!/.credo.exs
!/mix.exs
!/mix.lock

!/config/
!/config/*.exs

!/lib/
!/lib/**/
!/lib/**/*.ex
!/lib/**/*.heex

!/test/
!/test/**/
!/test/**/*.exs
!/test/**/*.ex

!/bench/
!/bench/*.exs
!/bench/*.mjs
!/bench/*.ts
!/bench/results/
!/bench/results/*.jsonl

!/assets/
!/assets/css/
!/assets/css/*.css
!/assets/js/
!/assets/js/*.ts
!/assets/wasm/
!/assets/wasm/*.wat
!/assets/tsconfig.json

!/priv/
!/priv/repo/
!/priv/repo/seeds.exs
!/priv/repo/migrations/
!/priv/repo/migrations/.formatter.exs
!/priv/repo/migrations/*.exs
!/priv/static/
!/priv/static/favicon.ico
!/priv/static/robots.txt
!/priv/static/images/
!/priv/static/images/*.svg
!/priv/static/wasm/
!/priv/static/wasm/*.wasm

!/alchemy/
!/alchemy/*.md

!/docs/
!/docs/*.md

!/.cursor/
!/.cursor/skills/
!/.cursor/skills/job-alchemy-distillation/
!/.cursor/skills/job-alchemy-distillation/SKILL.md

# The last word. A secret is never committed, whitelist or not.
/.env
/.env.*
!/.env.example
