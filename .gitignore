# Whitelist gitignore: everything is ignored unless named below.
# To track something new, name it here.
# https://rgbcu.be/blog/.gitignore/
*
!.gitignore
!/README.md
!/SECURITY.md
!/LICENSE
!/.formatter.exs
!/.credo.exs
!/mix.exs
!/mix.lock
!/flake.nix
!/flake.lock

!/nix/
!/nix/*.nix
!/nix/deploy.sh
!/nix/mcp-replay.py

!/secrets/
!/secrets/master/
!/secrets/master/*.age

!/config/
!/config/*.exs

!/lib/
!/lib/**/
!/lib/**/*.ex

# The one declaration every language reads.
!/schema/
!/schema/*.schema

# Generated SQL is a checked artifact; build output is not.
!/priv/
!/priv/schema.json
!/priv/db/
!/priv/db/*.sql
# The zstd dictionaries both wire ends embed (schema/hireme.schema's dict lines).
!/priv/wire/
!/priv/wire/*.zdict
# The deployed baseline's hash: `mix hireme.schema --freeze` writes it, and
# the cutover revision must carry it.
!/priv/db/baseline.lock
!/priv/db/.formatter.exs

!/test/
!/test/**/
!/test/**/*.exs
!/test/**/*.ex
!/test/e2e/run.sh
!/test/e2e/*.mjs

!/workers/
!/workers/mail/
!/workers/mail/wrangler.jsonc
!/workers/mail/src/
!/workers/mail/src/*.ts
!/workers/mail/test/
!/workers/mail/test/*.ts

!/bench/
!/bench/*.exs
!/bench/*.mjs
!/bench/*.sh

!/assets/
!/assets/css/
!/assets/css/*.css
!/assets/tsconfig.json
!/assets/test/
!/assets/test/*.mjs
!/assets/js/
!/assets/js/*.ts
!/assets/js/gen/
!/assets/js/gen/*.ts
!/assets/js/lenses/
!/assets/js/lenses/*.ts
!/assets/js/auth/
!/assets/js/auth/*.ts

# One workspace, one lockfile at the root, no build output.
!/native/
!/native/Cargo.toml
!/native/Cargo.lock
!/native/*/
!/native/*/Cargo.toml
!/native/*/build.rs
!/native/*/*.sh
!/native/*/*.mjs
!/native/*/*.patch
!/native/*/src/
!/native/*/src/**/
!/native/*/src/**/*.rs
!/native/kernel/tests/
!/native/kernel/tests/*.rs
!/native/kernel/tests/*.json
!/native/kernel/clippy.toml
!/native/*/tests/
!/native/*/tests/*.rs
!/native/*/benches/
!/native/*/benches/*.rs
!/native/*/examples/
!/native/*/examples/*.rs

!/.agents/
!/.agents/skills/
!/.agents/skills/*/
!/.agents/skills/*/SKILL.md
!AGENTS.md

!/docs/
!/docs/*.md
# AGENTS.md: documentation, research notes and WIP go in docs/{subfolder}/*.md.
!/docs/*/
!/docs/*/*.md

# The last word. A secret is never committed, whitelist or not.
/.env
/.env.*
